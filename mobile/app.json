{
  "expo": {
    "name": "Buyticle Store",
    "slug": "buyticle-store",
    "scheme": "buyticle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.buyticle.btlmarketplace",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone-adaptative.png",
        "backgroundColor": "#141B4D"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.buyticle.btlmarketplace",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pour te montrer le chemin jusqu'à la boutique où t'attend ton article."
      },
      "icon": "./assets/icone.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#141B4D",
          "icon": "./assets/icone-adaptative.png"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pour te montrer le chemin jusqu'à la boutique où t'attend ton article."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fc96c1ef-1641-4a95-9ab5-f3f0731efbe1"
      }
    },
    "owner": "onedev237",
    "updates": {
      "url": "https://u.expo.dev/fc96c1ef-1641-4a95-9ab5-f3f0731efbe1",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 8000
    },
    "icon": "./assets/icone.png",
    "splash": {
      "image": "./assets/marque.png",
      "resizeMode": "contain",
      "backgroundColor": "#141B4D"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}