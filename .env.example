# ─── Supabase ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Groq (assistant OFS) ───
VITE_GROQ_API_KEY=

# ─── LiveKit (vidéo live temps réel) ───
# URL WebSocket du projet LiveKit. Laisse vide pour désactiver la vidéo
# (le live reste fonctionnel : chat, enchères, achat). Voir docs/LIVE_SETUP.md
VITE_LIVEKIT_URL=

# Notifications poussées (Firebase Cloud Messaging)
# Sans cette clé, aucun jeton n'est enregistré et aucune notification ne part :
# les commerçants ne sauront jamais qu'on les interroge, et la couverture du
# rayon tombe à zéro.
# Où la trouver : console Firebase → Paramètres du projet → Cloud Messaging →
# « Certificats push Web » → paire de clés. À poser aussi dans Vercel.
VITE_FIREBASE_VAPID_KEY=
